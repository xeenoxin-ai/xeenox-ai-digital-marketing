{
  "name": "easyway",
  "private": true,
  "version": "0.1.0",
  "description": "Traffic-aware local routing, toll avoidance, breakdown workshop finder and a local AI assistant",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-easyway \"node --test tests/rules.emulator.js\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-easyway"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "firebase": "^12.19.0",
    "geofire-common": "^6.0.0",
    "leaflet": "1.9.4",
    "lucide": "^1.61.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.34.1",
    "vite": "5.4.21"
  }
}
